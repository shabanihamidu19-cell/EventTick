// EventTick Prisma Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  UPCOMING
  LIVE
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  PENDING
  PAID
  USED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EventCategory {
  MUSIC
  BUSINESS
  SPORTS
  CAMPUS
  ARTS
  TECHNOLOGY
  FOOD
  OTHER
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  avatarUrl     String?
  isVerified    Boolean   @default(false)
  isKycVerified Boolean   @default(false)
  kycDocumentUrl String?
  businessName  String?
  mobileMoneyNumber String?
  bankAccount   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organizedEvents Event[]     @relation("OrganizerEvents")
  tickets         Ticket[]
  follows         Follow[]    @relation("Follower")
  followers       Follow[]    @relation("Following")
  payments        Payment[]
  payouts         Payout[]
  otpCodes        OtpCode[]

  @@index([phone])
  @@index([role])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, code])
}

model Event {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String
  coverImageUrl   String?
  location        String
  city            String
  venue           String?
  category        EventCategory
  status          EventStatus   @default(UPCOMING)
  startDate       DateTime
  endDate         DateTime
  ticketPrice     Decimal       @db.Decimal(12, 2)
  currency        String        @default("TZS")
  totalTickets    Int
  soldTickets     Int           @default(0)
  isFeatured      Boolean       @default(false)
  organizerId     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organizer User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  tickets   Ticket[]
  payouts   Payout[]

  @@index([status])
  @@index([city])
  @@index([category])
  @@index([slug])
  @@index([startDate])
  @@index([organizerId])
}

model Ticket {
  id            String       @id @default(cuid())
  ticketCode    String       @unique
  qrData        String
  status        TicketStatus @default(PENDING)
  pricePaid     Decimal      @db.Decimal(12, 2)
  currency      String       @default("TZS")
  scannedAt     DateTime?
  scannedById   String?
  eventId       String
  userId        String
  paymentId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([ticketCode])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  externalRef       String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("TZS")
  status            PaymentStatus @default(PENDING)
  phone             String
  gatewayResponse   Json?
  userId            String
  eventId           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  tickets Ticket[]

  @@index([externalRef])
  @@index([userId])
  @@index([status])
}

model Payout {
  id              String       @id @default(cuid())
  amount          Decimal      @db.Decimal(12, 2)
  commission      Decimal      @db.Decimal(12, 2)
  netAmount       Decimal      @db.Decimal(12, 2)
  currency        String       @default("TZS")
  status          PayoutStatus @default(PENDING)
  destination     String
  gatewayRef      String?
  gatewayResponse Json?
  eventId         String
  organizerId     String
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event     Event @relation(fields: [eventId], references: [id])
  organizer User  @relation(fields: [organizerId], references: [id])

  @@index([eventId])
  @@index([organizerId])
  @@index([status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
