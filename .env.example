# ===========================================
# EventTick - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----- Database -----
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventtick?schema=public"

# ----- Authentication -----
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
JWT_EXPIRES_IN="7d"

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EventTick"

# Platform commission fee (percentage, e.g. 5 = 5%)
PLATFORM_COMMISSION_PERCENT="5"

# ----- Payment Gateway (AzamPay / ClickPesa / Selcom style) -----
# Replace with your actual provider credentials
PAYMENT_GATEWAY_API_KEY="your_payment_api_key"
PAYMENT_GATEWAY_SECRET="your_payment_api_secret"
PAYMENT_GATEWAY_BASE_URL="https://api.example-payment.com/v1"
PAYMENT_CALLBACK_URL="http://localhost:3000/api/v1/payments/callback"
# Disbursement / Payout endpoint path (relative to BASE_URL)
PAYMENT_DISBURSEMENT_PATH="/disburse"

# ----- SMS Gateway (Africa's Talking / Twilio / custom) -----
SMS_GATEWAY_API_KEY="your_sms_api_key"
SMS_GATEWAY_SENDER_ID="EventTick"
SMS_GATEWAY_BASE_URL="https://api.example-sms.com/v1"

# ----- WhatsApp Business API (Meta / Twilio / custom) -----
WHATSAPP_API_KEY="your_whatsapp_api_key"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BASE_URL="https://graph.facebook.com/v18.0"

# ----- Cron / Background Jobs -----
# Secret to protect the cron endpoint (optional but recommended)
CRON_SECRET="your-cron-secret-token"

# ----- Optional: Social Login (placeholders) -----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
